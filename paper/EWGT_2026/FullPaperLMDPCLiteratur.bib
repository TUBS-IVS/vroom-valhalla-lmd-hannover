@article{castilloGreenerCityLogistics2024,
  title = {{Towards Greener City Logistics: An Application of Agile Routing Algorithms to Optimize the Distribution of Micro-Hubs in Barcelona}},
  shorttitle = {{Towards Greener City Logistics}},
  author = {Castillo, C. and Panadero, J. and {Alvarez-Palau}, E. J. and Juan, A. A.},
