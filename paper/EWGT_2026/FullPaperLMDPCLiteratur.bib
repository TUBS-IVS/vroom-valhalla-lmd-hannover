  doi = {10.1016/j.jtrangeo.2026.104682},
  urldate = {2026-05-12},
  abstract = {Rising parcel volumes increase operational and environmental pressures in last-mile delivery (LMD) systems. While these impacts are highly visible in dense urban areas, existing research and model-based analyses largely focus on urban contexts and rarely examine suburban and rural delivery structures in a systematic way. As a result, the operational and environmental relevance of non-urban deliveries for system-wide LMD performance remains insufficiently understood.},
