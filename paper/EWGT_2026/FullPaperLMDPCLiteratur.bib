@article{shethMeasuringDeliveryRoute2019,
  title = {{Measuring Delivery Route Cost Trade-Offs between Electric-Assist Cargo Bicycles and Delivery Trucks in Dense Urban Areas}},
  author = {Sheth, Manali and Butrina, Polina and Goodchild, Anne and McCormack, Edward},
